[
  { "at": 0,
    "lag": true,    "lag-time": 80 },

  { "at": 10,
    "jitter": true, "jitter-min": 10, "jitter-max": 60 },

  { "at": 20,
    "drop": true,   "drop-chance": 5.0 },

  { "at": 35,
    "burstloss": true,
    "burstloss-good": 1.0, "burstloss-bad": 60.0,
    "burstloss-gb": 8.0,   "burstloss-bg": 25.0 },

  { "at": 50,
    "blackout": true, "blackout-duration": 3000, "blackout-gap": 20000,
    "bandwidth": true, "bandwidth-bandwidth": 1000 },

  { "at": 75,
    "lag": false, "jitter": false, "drop": false,
    "burstloss": false, "blackout": false, "bandwidth": false },

  {
    "_comment": "Phase 3.2 condition trigger: tighten the bandwidth cap once the",
    "_comment2": "session has actually pushed 20000 packets, however long that takes.",
    "when": "captured_count", "op": ">=", "value": 20000,
    "bandwidth": true, "bandwidth-bandwidth": 200
  },

  {
    "_comment": "Fires when the lag buffer backs up past 500 packets, which means",
    "_comment3": "the client is not draining fast enough; back the delay off.",
    "when": "lag_buf", "op": ">", "value": 500,
    "lag-time": 20
  },

  {
    "_comment": "Phase 3.2 repeat: re-randomize the drop rate every 30s, 5 times.",
    "at": 90, "repeat": 30, "times": 5,
    "drop": true, "drop-chance": 12.0
  }
]
